+static struct list_head *css_set_e_cset_node(struct css_set *cset, int ssid)
+{
+#ifdef CONFIG_CGROUP_PIDS
+	if (ssid == pids_cgrp_id)
+		return &css_set_pids_storage(cset)->e_cset_node;
+#endif
+	return &cset->e_cset_node[ssid];
+}
+
+static struct css_set *css_set_from_e_cset_node(struct list_head *node, int ssid)
+{
+#ifdef CONFIG_CGROUP_PIDS
+	if (ssid == pids_cgrp_id) {
+		struct css_set_pids_kabi *pids;
+
+		pids = container_of(node, struct css_set_pids_kabi, e_cset_node);
+		if (pids == &init_css_set_pids)
+			return &init_css_set;
+		return (struct css_set *)pids - 1;
+	}
+#endif
+	return container_of(node, struct css_set, e_cset_node[ssid]);
