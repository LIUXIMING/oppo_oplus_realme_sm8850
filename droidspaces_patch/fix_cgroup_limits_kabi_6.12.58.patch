+};
+
+/* The two boot-time objects are static and therefore have no allocation tail. */
+static struct css_set_pids_kabi init_css_set_pids;
+static struct cgroup_pids_kabi cgrp_dfl_root_pids;
+
+static struct css_set_pids_kabi *css_set_pids_storage(struct css_set *cset)
+{
+	if (cset == &init_css_set)
+		return &init_css_set_pids;
+	return (struct css_set_pids_kabi *)(cset + 1);
+}
+
+/*
+ * Dynamic roots allocate the extension after struct cgroup_root.  Other
+ * cgroups allocate it after the full object and its ancestors[] storage.
+ * Trailing structure alignment padding remains untouched.  Both root and
+ * level must therefore be set before init_cgroup_housekeeping().  These
+ * tails share their owner's allocation and RCU lifetime.
+ */
+static struct cgroup_pids_kabi *cgroup_pids_storage(struct cgroup *cgrp)
+{
+	if (cgrp == &cgrp_dfl_root.cgrp)
+		return &cgrp_dfl_root_pids;
+	if (!cgrp->level)
+		return (struct cgroup_pids_kabi *)(cgrp->root + 1);
+	return (struct cgroup_pids_kabi *)((char *)cgrp +
+		struct_size(cgrp, ancestors, cgrp->level + 1));
+}
+
+struct cgroup_subsys_state *css_set_pids(struct css_set *cset)
+{
+	return css_set_pids_storage(cset)->subsys;
+}
+EXPORT_SYMBOL_GPL(css_set_pids);
+
+#define CSS_SET_PIDS_KABI_SIZE sizeof(struct css_set_pids_kabi)
+#else
+#define CSS_SET_PIDS_KABI_SIZE 0
+#endif
+
+static struct cgroup_subsys_state **css_set_subsys_slot(struct css_set *cset,
+						     int ssid)
+{
+#ifdef CONFIG_CGROUP_PIDS
+	if (ssid == pids_cgrp_id)
+		return &css_set_pids_storage(cset)->subsys;
+#endif
+	return &cset->subsys[ssid];
+}
+
+struct cgroup_subsys_state __rcu **
+cgroup_subsys_slot(struct cgroup *cgrp, int ssid)
+{
+#ifdef CONFIG_CGROUP_PIDS
+	if (ssid == pids_cgrp_id)
+		return &cgroup_pids_storage(cgrp)->subsys;
+#endif
+	return &cgrp->subsys[ssid];
